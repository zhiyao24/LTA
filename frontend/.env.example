# Public browser configuration only. Never put secret API keys or device tokens here.
# Same-origin API proxy works from this Mac and other LAN devices, HTTP or HTTPS.
VITE_API_BASE_URL=/
# Server-side settings (not exposed to the browser).
LTA_BACKEND_PORT=8000
FRONTEND_HTTPS=false
# Optional browser-visible Maps key; NOT a secret. Restrict to allowed websites
# and Maps JavaScript API. Set the actual key in ignored frontend/.env.local.
VITE_GOOGLE_MAPS_API_KEY=
