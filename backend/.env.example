# Copy these values into your shell or a private backend/.env file.
# This example contains no passwords, API keys, or device tokens.
APP_NAME="Local Jetson Control API"
APP_ENV=development
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
LOG_LEVEL=INFO
DATABASE_PATH="backend/data/lta.db"

# The start script defaults to loopback-only. Use 0.0.0.0 only when a Jetson
# on the same trusted Wi-Fi network must reach this Mac.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Keep mock mode until the real provider, authentication method, and fields are known.
EXTERNAL_API_MODE=mock
EXTERNAL_API_URL=""
EXTERNAL_API_KEY=""
EXTERNAL_API_TIMEOUT_SECONDS=5

# LTA DataMall Bus Arrival v3. Add your private AccountKey only to backend/.env.
# The provider URL is fixed to LTA HTTPS; the browser never receives this key.
LTA_API_ACCOUNT_KEY=""

# Leave both blank to keep all command routes disabled by default.
# Use two different random values in a private backend/.env file.
OPERATOR_API_TOKEN=""
JETSON_API_TOKEN=""

# Device liveness and bounded telemetry storage.
JETSON_HEARTBEAT_TIMEOUT_SECONDS=10
TELEMETRY_STALE_AFTER_SECONDS=15
TELEMETRY_RETENTION_HOURS=168
